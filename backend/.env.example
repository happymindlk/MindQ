# ---------------------------------------------------------------------------
# Backend configuration (thin FastAPI service_role service)
# ---------------------------------------------------------------------------

# Postgres connection (async driver).
# Local Supabase stack (supabase start) exposes Postgres on port 54322:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# Secret used to sign candidate access tokens (NOT the Supabase JWT secret).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# When DEBUG=false the process refuses to boot if this is still the example value.
SECRET_KEY=dev-secret-key-change-in-production
# Candidate login requires a Supabase email-OTP token. Set false ONLY for local
# scripts without Supabase Auth (e.g. scripts/e2e_candidate_loop.py). Must be true in prod.
CANDIDATE_OTP_REQUIRED=true

# Supabase project settings. For a local stack, `supabase start` prints these.
SUPABASE_URL=http://127.0.0.1:54321
# service_role key: server-side ONLY, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Used to verify HR access tokens issued by Supabase Auth (HS256).
# When DEBUG=false this must not be the local stack default.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Cloudflare R2 (S3-compatible) for generated PDF/HTML report archives.
# When unset, report download still works; archiving is skipped best-effort.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 API host (…r2.cloudflarestorage.com) — used by boto3 for put/get/presign
R2_ENDPOINT_URL=
R2_BUCKET_NAME=assess-pulse
# Public CDN / r2.dev base (no trailing slash) — used for logo public URLs
R2_PUBLIC_URL=

# App
PROJECT_NAME=MindQ
# DEBUG=true allows local default secrets. Production MUST set DEBUG=false and
# replace SECRET_KEY / SUPABASE_JWT_SECRET / CORS_ORIGINS with real values.
DEBUG=true
# Production: set to your deployed frontend origin(s), not localhost.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Gemini (optional). When unset, reports still download with objective scores
# and a "JD fit unavailable" note. Never send this key to the browser.
# New API keys cannot call gemini-2.5-*; Google returns 404 NOT_FOUND.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Comma-separated chain tried in order after 429/503 exhaustion (blank disables).
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45
# Free-tier: 3 generate_content attempts per model with exponential backoff on 429.
GEMINI_MAX_RETRIES=3
# Submit-time background scoring retries longer, with jittered backoff.
GEMINI_BACKGROUND_MAX_RETRIES=5
GEMINI_RETRY_BASE_SECONDS=2
GEMINI_RETRY_MAX_DELAY_SECONDS=30
# Seconds between sequential custom-technical item evaluations (RPM throttle).
GEMINI_INTER_REQUEST_SECONDS=2
NUDGE_AFTER_HOURS=24

# Public origin of the React app (invite emails use `{FRONTEND_URL}/assessment?code=`).
FRONTEND_URL=http://localhost:5173
# Candidate-facing portal URL used in notification emails.
PORTAL_URL=http://localhost:5173/portal

# Resend transactional email. When unset, outbound mail is skipped (logged).
# Use onboarding@resend.dev until your domain is verified.
RESEND_API_KEY=
EMAIL_FROM=Assess Pulse <onboarding@resend.dev>
# Must match your verified Resend account email while using onboarding@resend.dev
ADMIN_NOTIFICATION_EMAIL=muhamadnas44@gmail.com
# Local/dev bypass: comma-separated emails auto-provisioned into the "acme" tenant
# (skips Resend waitlist). Example:
# AUTO_APPROVE_EMAILS=dev@example.com,qa@example.com
AUTO_APPROVE_EMAILS=
