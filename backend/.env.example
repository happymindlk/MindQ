# ---------------------------------------------------------------------------
# Backend configuration (thin FastAPI service_role service)
# ---------------------------------------------------------------------------

# Postgres connection (async driver).
# Local Supabase stack (supabase start) exposes Postgres on port 54322:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
# Production/staging: Supavisor Transaction Mode pooler (port 6543 -- not session 5432):
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Secret used to sign candidate access tokens (NOT the Supabase JWT secret).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# When DEBUG=false the process refuses to boot if this is still the example value.
SECRET_KEY=dev-secret-key-change-in-production
# Candidate login requires a Supabase email-OTP token. Set false ONLY for local
# scripts without Supabase Auth (e.g. scripts/e2e_candidate_loop.py). Must be true in prod.
CANDIDATE_OTP_REQUIRED=true

# Supabase project settings. For a local stack, `supabase start` prints these.
SUPABASE_URL=http://127.0.0.1:54321
# service_role key: server-side ONLY, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Used to verify HR access tokens issued by Supabase Auth (HS256).
# When DEBUG=false this must not be the local stack default.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Public Storage bucket for company logos (created by migrations as corporate-logos).
# Public URL shape: {SUPABASE_URL}/storage/v1/object/public/{bucket}/{corporate_id}/{file}
SUPABASE_LOGO_BUCKET=corporate-logos

# Optional S3-compatible fallback for logos + private report archives.
# Logos prefer Supabase Storage above. Either naming style works:
#   R2_*  (legacy)  OR  AWS_S3_* / AWS_STORAGE_BUCKET_NAME / STORAGE_PUBLIC_BASE_URL
# Do NOT reuse AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here -- those are SES-only.
# AWS_S3_ACCESS_KEY_ID=
# AWS_S3_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
# AWS_S3_REGION_NAME=us-east-1
# AWS_STORAGE_BUCKET_NAME=corporate-logos
# STORAGE_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/corporate-logos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=assess-pulse
R2_PUBLIC_URL=
R2_REGION=
# PRIVATE bucket for candidate reports (no public access).
# Must differ from the public logo bucket. Blank = report archiving disabled.
R2_REPORTS_BUCKET_NAME=
# Presigned report URL lifetime in seconds (capped at 1800).
REPORT_URL_TTL_SECONDS=900

# App
PROJECT_NAME=MindQ
# DEBUG=true allows local default secrets. Production MUST set DEBUG=false and
# replace SECRET_KEY / SUPABASE_JWT_SECRET / CORS_ORIGINS with real values.
DEBUG=true
# Production: exact https origins only (no wildcards), e.g.
# CORS_ORIGINS=https://mindqtalent.com,https://qa.mindqtalent.com,https://mindq-qa.pages.dev
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Rate limits key on client IP. Behind Cloudflare/Render set TRUSTED_PROXY_HOPS=1 and
# CLIENT_IP_HEADER=CF-Connecting-IP. Leave 0 when the API is reached directly, otherwise
# clients can forge X-Forwarded-For to bypass throttling.
TRUSTED_PROXY_HOPS=0
CLIENT_IP_HEADER=

# Gemini (optional). When unset, reports still download with objective scores
# and a "JD fit unavailable" note. Never send this key to the browser.
# Use a stable (pinned) model id -- never *-latest / *-preview / *-exp.
# New API keys cannot call gemini-2.5-*; Google returns 404 NOT_FOUND.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Comma-separated chain tried in order after 429/503 exhaustion (blank disables).
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
# Free-tier: 3 generate_content attempts per model with exponential backoff on 429.
GEMINI_MAX_RETRIES=3
# Submit-time background scoring retries longer, with jittered backoff.
GEMINI_BACKGROUND_MAX_RETRIES=5
GEMINI_RETRY_BASE_SECONDS=2
GEMINI_RETRY_MAX_DELAY_SECONDS=30
# Seconds between sequential custom-technical item evaluations (RPM throttle).
GEMINI_INTER_REQUEST_SECONDS=2
# Paid-tier list prices (USD / 1M tokens) for estimated_cost_usd on evaluations.
GEMINI_INPUT_USD_PER_1M=1.50
GEMINI_OUTPUT_USD_PER_1M=9.00
GEMINI_LITE_INPUT_USD_PER_1M=0.25
GEMINI_LITE_OUTPUT_USD_PER_1M=1.50
NUDGE_AFTER_HOURS=24

# Durable background jobs (ARQ). Local: `docker compose up redis` then
# `arq app.jobs.worker.WorkerSettings` alongside uvicorn.
REDIS_URL=redis://localhost:6379/0
# ARQ_MAX_JOBS=10
# ARQ_JOB_TIMEOUT=300
# ARQ_MAX_TRIES=3

# Public origin of the React app (invite emails use `{FRONTEND_URL}/assessment?code=`).
FRONTEND_URL=http://localhost:5173
# Candidate-facing portal URL used in notification emails.
PORTAL_URL=http://localhost:5173/portal

# AWS SES transactional email (boto3). When credentials are unset, outbound mail
# is skipped and logged. In SES Sandbox you must verify BOTH the From identity
# and every recipient (e.g. ADMIN_NOTIFICATION_EMAIL) under SES → Identities.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Must be a verified SES identity (email or domain). Display name is optional.
EMAIL_FROM=Assess Pulse <noreply@your-verified-domain.com>
ADMIN_NOTIFICATION_EMAIL=muhamadnas44@gmail.com
# Emergency Super Admin bootstrap (comma-separated). These emails always retain
# ops access and appear as System / Env Managed in /admin/team (cannot revoke).
# Prefer granting Super Admins from the Team UI instead of editing this list.
# OPS_ADMIN_EMAILS=ops@mindqtalent.com
OPS_ADMIN_EMAILS=
# Local/dev bypass: comma-separated emails auto-provisioned into the "acme" tenant
# (skips waitlist). Example:
# AUTO_APPROVE_EMAILS=dev@example.com,qa@example.com
AUTO_APPROVE_EMAILS=
