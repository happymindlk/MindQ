# Cloudflare Pages response headers.
# frame-ancestors is ignored in <meta> CSP, so clickjacking protection must ship as a
# real header. Browsers enforce every CSP they receive, so this header only carries
# frame-ancestors; the full policy stays in index.html.
/*
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
