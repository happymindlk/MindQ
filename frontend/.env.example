# Frontend (Vite) configuration
# The HR admin app talks to Supabase directly via supabase-js; RLS enforces tenancy.
# For a local stack, `supabase start` prints the URL and anon/publishable key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Base URL of the thin FastAPI service (candidate flow, reports).
# Leave empty to use the Vite dev proxy (/api -> 127.0.0.1:8000).
VITE_API_URL=
