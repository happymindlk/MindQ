# Frontend (Vite) configuration
# The HR admin app talks to Supabase directly via supabase-js; RLS enforces tenancy.
# For a local stack, `supabase start` prints the URL and anon/publishable key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Origin of the FastAPI service (candidate flow, reports), without a trailing /api.
# Local: leave empty so the Vite dev proxy forwards /api -> 127.0.0.1:8000.
# Staging/production builds read .env.production (https://api-qa.mindqtalent.com);
# a VITE_API_URL set in the Cloudflare Pages dashboard overrides it.
# Production builds ignore non-HTTPS values and fall back to same-origin /api,
# served by the Pages Function proxy (functions/api/[[catchall]].js).
# Any new API origin must also be added to connect-src in index.html.
VITE_API_URL=
